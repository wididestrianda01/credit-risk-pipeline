# Copy this file to .env for local development
# Never commit .env (already in .gitignore)

CREDIT_RISK_API_KEY=your-test-key-here

# Hugging Face Hub — required on Streamlit Community Cloud (model is not in git)
# Set to your HF Hub username + model repo name, e.g. "wididestrianda01/credit-risk-models"
# On Community Cloud: set via Settings → Secrets UI, not here.
HF_REPO_ID=your-hf-username/your-model-repo
# HF_TOKEN=hf_your_api_token_here  # Optional — only needed for private repos
