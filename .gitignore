# Root-level markdown files (private notes, AI guidance, reference docs)
# Keep README.md tracked; ignore everything else at root level
/*.md
!README.md

# Claude Code local settings
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (large files — download via Kaggle API or generated during runs)
data/
!data/processed/feature_removal_audit.txt
dataset/

# Generated figures (produced by executing notebooks)
reports/figures/

# Generated scan and codemap diff reports
.reports/

# Model artefacts
models/
*.pkl
*.joblib
*.json.model
*.pt
*.onnx

# Hyperparameter optimisation storage
optuna.db
optuna_study.db
*.db

# Temporary run logs and outputs
*.log
rebuild_output.log
reports/*.log
reports/*.csv
reports/feature_store_comparison.json
reports/lgb_feature_store_selection.json
reports/lgb_raw_*.json
reports/imbalance_benchmark.csv
reports/ensemble_*.log

# Model training artifacts
catboost_info/

# Documentation stubs (not committed)
docs/
context/

# Environment
.env
*.env
kaggle.json

# IDE
.vscode/
.idea/
.planning/
